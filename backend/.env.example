# ============================================================
# AIMLess — Environment Configuration
# ============================================================

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true

# API Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="AIMLess — India Air Quality Intelligence Platform"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# SIH Demo Mode (Set to true to use reproducible benchmark dataset)
DEMO_MODE=true

# Data Storage Directories
DATA_DIR=backend/data
RAW_DATA_DIR=backend/data/raw
PROCESSED_DATA_DIR=backend/data/processed
FEATURE_STORE_DIR=backend/data/features

# Machine Learning Model Artifacts
MODEL_DIR=backend/app/ml/models

# Optional External API Keys (Do not commit actual keys)
CPCB_API_KEY=
NASA_FIRMS_MAP_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
MOSDAC_API_KEY=
